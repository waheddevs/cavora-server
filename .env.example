NODE_ENV=development
PORT=3008
SERVER_HOST=0.0.0.0
TRUST_PROXY=0
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

MONGO_URL=mongodb://localhost:27017/cavora
MONGO_TEST_URL=mongodb://localhost:27018/cavora_test

# Secure opaque sessions and CSRF protection
SESSION_COOKIE_NAME=cavora_session
CSRF_COOKIE_NAME=cavora_csrf
SESSION_TTL_HOURS=24
SESSION_TOKEN_PEPPER=replace_with_a_long_random_secret
CSRF_SECRET=replace_with_a_different_long_random_secret
COOKIE_SAME_SITE=lax
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
