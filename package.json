{
  "name": "cavora-server",
  "version": "1.0.0",
  "description": "Cavora travel-booking REST API built with Express and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run vendor && tsc",
    "vendor": "node scripts/copy-vendor.mjs",
    "postinstall": "node scripts/copy-vendor.mjs",
    "start": "node dist/server.js",
    "start:dev": "nodemon --exec ts-node src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "seed": "tsx src/seed.ts",
    "seed:generate": "tsx scripts/generate-tour-seed.ts"
  },
  "keywords": [
    "travel",
    "booking",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.8.0",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "stripe": "^20.4.0",
    "swagger-ui-express": "^5.0.1",
    "sweetalert2": "^11.26.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0"
  }
}
