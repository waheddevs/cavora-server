<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title><%= pageTitle %> | Cavora Admin</title>
    <link rel="stylesheet" href="/assets/vendor/sweetalert2.min.css" />
    <link rel="stylesheet" href="/assets/css/admin-shell.css" />
    <link rel="stylesheet" href="/assets/css/sweetalert-theme.css" />
    <link rel="stylesheet" href="<%= stylesheetPath %>" data-page-stylesheet />
  </head>
  <body class="admin-page">
    <div
      class="admin-notice"
      data-admin-notice
      role="status"
      aria-live="polite"
      aria-atomic="true"
      hidden
    >
      <span data-admin-notice-message></span>
      <button type="button" data-admin-notice-close>Dismiss</button>
    </div>

    <div
      class="admin-shell"
      data-admin-shell
      data-csrf-cookie-name="<%= csrfCookieName %>"
    >
      <aside class="admin-sidebar" id="admin-sidebar" aria-label="Administration navigation">
        <div class="admin-sidebar__profile">
          <a class="admin-identity" href="/admin/profile" aria-label="Open your profile">
            <span class="admin-identity__avatar" aria-hidden="true">
              <img data-identity-avatar alt="" hidden />
              <span data-identity-initial>A</span>
            </span>
            <strong data-identity-name>Administrator</strong>
          </a>
          <button class="admin-sidebar__logout" type="button" data-admin-logout>
            <span>Log out</span>
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>

        <nav class="admin-nav">
          <p class="admin-nav__label">Workspace</p>
          <% const adminLinks = [
            ['dashboard', 'Dashboard', '/admin/dashboard'],
            ['profile', 'Profile', '/admin/profile'],
            ['tours', 'Tours', '/admin/tours'],
            ['departures', 'Departures', '/admin/departures'],
            ['bookings', 'Bookings', '/admin/bookings'],
            ['payments', 'Payments', '/admin/payments'],
            ['users', 'Users', '/admin/users'],
            ['faqs', 'FAQ', '/admin/faqs'],
            ['posts', 'Blog posts', '/admin/posts'],
            ['comments', 'Comments', '/admin/comments'],
            ['contact-messages', 'Contact messages', '/admin/contact-messages'],
          ]; %>
          <% for (const [page, label, href] of adminLinks) { %>
            <a
              class="admin-nav__link <%= activePage === page ? 'is-active' : '' %>"
              href="<%= href %>"
              <%- activePage === page ? 'aria-current="page"' : '' %>
            >
              <%= label %>
            </a>
          <% } %>
        </nav>
      </aside>

      <div class="admin-workspace">
        <button
          class="admin-menu-button admin-menu-button--floating"
          type="button"
          aria-controls="admin-sidebar"
          aria-expanded="false"
          data-sidebar-toggle
        >
          <span aria-hidden="true">&#9776;</span>
          <span>Menu</span>
        </button>

        <script src="/assets/js/admin-bootstrap.js"></script>

        <main class="admin-main">
