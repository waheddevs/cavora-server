<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title><%= pageTitle %> | Cavora Admin</title>
    <link rel="stylesheet" href="/assets/css/admin-shell.css" />
    <link rel="stylesheet" href="<%= stylesheetPath %>" />
  </head>
  <body class="admin-page">
    <div
      class="admin-notice"
      data-admin-notice
      role="status"
      aria-live="polite"
      aria-atomic="true"
      hidden
    >
      <span data-admin-notice-message></span>
      <button type="button" data-admin-notice-close>Dismiss</button>
    </div>

    <div
      class="admin-shell"
      data-admin-shell
      data-csrf-cookie-name="<%= csrfCookieName %>"
    >
      <aside class="admin-sidebar" id="admin-sidebar" aria-label="Administration navigation">
        <a class="admin-brand" href="/admin" aria-label="Cavora admin dashboard">
          <span class="admin-brand__mark" aria-hidden="true">C</span>
          <span>
            <strong>Cavora</strong>
            <small>Administration</small>
          </span>
        </a>

        <nav class="admin-nav">
          <p class="admin-nav__label">Workspace</p>
          <% const adminLinks = [
            ['dashboard', 'Dashboard', '/admin'],
            ['tours', 'Tours', '/admin/tours'],
            ['departures', 'Departures', '/admin/departures'],
            ['homepage', 'Homepage', '/admin/homepage'],
            ['bookings', 'Bookings', '/admin/bookings'],
            ['payments', 'Payments', '/admin/payments'],
            ['posts', 'Blog posts', '/admin/posts'],
            ['comments', 'Comments', '/admin/comments'],
            ['contact-messages', 'Contact messages', '/admin/contact-messages'],
            ['newsletter-subscriptions', 'Newsletter', '/admin/newsletter-subscriptions'],
          ]; %>
          <% for (const [page, label, href] of adminLinks) { %>
            <a
              class="admin-nav__link <%= activePage === page ? 'is-active' : '' %>"
              href="<%= href %>"
              <%- activePage === page ? 'aria-current="page"' : '' %>
            >
              <%= label %>
            </a>
          <% } %>
        </nav>
      </aside>

      <div class="admin-workspace">
        <header class="admin-topbar">
          <button
            class="admin-menu-button"
            type="button"
            aria-controls="admin-sidebar"
            aria-expanded="false"
            data-sidebar-toggle
          >
            <span aria-hidden="true">☰</span>
            <span>Menu</span>
          </button>
          <div>
            <p class="admin-topbar__eyebrow">Cavora operations</p>
            <h1><%= pageTitle %></h1>
          </div>
          <div class="admin-topbar__actions">
            <div class="admin-account" data-admin-account>
              <span class="admin-account__avatar" data-admin-initial aria-hidden="true">A</span>
              <span class="admin-account__identity">
                <strong data-admin-name>Administrator</strong>
                <small data-admin-email>Loading account…</small>
              </span>
              <button class="button button--small" type="button" data-admin-logout>
                Log out
              </button>
            </div>
          </div>
        </header>

        <main class="admin-main">
