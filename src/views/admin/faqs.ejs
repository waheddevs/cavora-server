<%- include('../includes/header', {
  activePage,
  layoutMode,
  pageTitle,
  stylesheetPath,
}) %>

<section class="page-heading">
  <div>
    <p class="section-label">Help center</p>
    <h1>Frequently Asked Questions</h1>
    <p>Maintain the answers customers see on the Cavora FAQ page.</p>
  </div>
  <button
    class="button button--primary"
    type="button"
    aria-controls="faq-editor"
    aria-expanded="false"
    data-faq-editor-toggle
  >
    New FAQ
  </button>
</section>

<section class="panel" id="faq-editor" data-faq-editor hidden>
  <div class="panel__header">
    <div>
      <h3 data-faq-editor-title>FAQ editor</h3>
      <p>Choose where the answer appears, then publish it when it is ready.</p>
    </div>
    <button class="button button--small" type="button" data-disclosure-close>Close</button>
  </div>
  <form data-faq-form novalidate>
    <div class="form-grid form-grid--three">
      <label class="field">
        <span>Section</span>
        <select name="section" required>
          <option value="OVERVIEW">Overview</option>
          <option value="PAYMENTS">Costs and payments</option>
          <option value="SAFETY">Safety and Security</option>
        </select>
      </label>
      <label class="field">
        <span>Position</span>
        <input type="number" name="position" min="1" max="999" value="1" required />
      </label>
      <label class="field">
        <span>Status</span>
        <select name="status" required>
          <option value="PUBLISHED">Published</option>
          <option value="DRAFT">Draft</option>
        </select>
      </label>
      <label class="field field--full">
        <span>Question</span>
        <input type="text" name="question" maxlength="500" required />
      </label>
      <label class="field field--full">
        <span>Answer</span>
        <textarea name="answer" maxlength="5000" required></textarea>
      </label>
    </div>
    <p class="form-feedback" data-form-feedback aria-live="polite"></p>
    <div class="form-actions">
      <button class="button" type="reset">Clear</button>
      <button class="button button--primary" type="submit" data-faq-submit>Save FAQ</button>
    </div>
  </form>
</section>

<form class="toolbar" data-faq-filters>
  <label class="field field--wide">
    <span>Search FAQs</span>
    <input type="search" name="query" maxlength="200" placeholder="Question or answer" />
  </label>
  <label class="field">
    <span>Section</span>
    <select name="section">
      <option value="">All sections</option>
      <option value="OVERVIEW">Overview</option>
      <option value="PAYMENTS">Costs and payments</option>
      <option value="SAFETY">Safety and Security</option>
    </select>
  </label>
  <label class="field">
    <span>Status</span>
    <select name="status">
      <option value="">All statuses</option>
      <option value="PUBLISHED">Published</option>
      <option value="DRAFT">Draft</option>
    </select>
  </label>
  <button class="button" type="submit">Apply</button>
  <button class="button" type="button" data-filter-reset>Reset</button>
</form>

<section class="table-card" aria-label="FAQ records">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Question</th>
          <th scope="col">Section</th>
          <th scope="col">Position</th>
          <th scope="col">Status</th>
          <th scope="col">Updated</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody data-faq-rows></tbody>
    </table>
  </div>
  <div class="empty-state" data-faq-empty>
    <div class="empty-state__mark" aria-hidden="true">?</div>
    <h3>No FAQs loaded</h3>
    <p>No FAQ entries match the current filters.</p>
  </div>
  <div class="pagination">
    <span data-page-summary>Page 1 of 1</span>
    <div class="pagination__actions">
      <button class="button button--small" type="button" data-page-prev disabled>Previous</button>
      <button class="button button--small" type="button" data-page-next disabled>Next</button>
    </div>
  </div>
</section>

<%- include('../includes/footer', { layoutMode, scriptPath }) %>
