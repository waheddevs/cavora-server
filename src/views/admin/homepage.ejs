<%- include('../includes/header', {
  activePage,
  layoutMode,
  pageTitle,
  stylesheetPath,
}) %>

<section class="page-heading">
  <div>
    <p class="section-label">Merchandising</p>
    <h2>Homepage selections</h2>
    <p>Control which published tours appear in the main public discovery sections.</p>
  </div>
</section>

<form class="homepage-form" data-homepage-form novalidate>
  <div class="selection-grid">
    <section class="panel">
      <div class="panel__header">
        <div>
          <h3>Featured tours</h3>
          <p>Up to 12 unique public tour IDs.</p>
        </div>
        <span class="badge">Maximum 12</span>
      </div>
      <label class="field">
        <span>Featured tour IDs</span>
        <textarea
          name="featuredTourIds"
          placeholder="101, 102, 103"
          aria-describedby="featured-help"
          required
        ></textarea>
        <small id="featured-help">Separate IDs with commas.</small>
      </label>
    </section>

    <section class="panel">
      <div class="panel__header">
        <div>
          <h3>Popular tours</h3>
          <p>Up to 12 unique public tour IDs.</p>
        </div>
        <span class="badge">Maximum 12</span>
      </div>
      <label class="field">
        <span>Popular tour IDs</span>
        <textarea
          name="popularTourIds"
          placeholder="201, 202, 203"
          aria-describedby="popular-help"
          required
        ></textarea>
        <small id="popular-help">Separate IDs with commas.</small>
      </label>
    </section>

    <section class="panel spotlight-panel">
      <div class="panel__header">
        <div>
          <h3>Spotlight tour</h3>
          <p>One primary tour for the homepage spotlight.</p>
        </div>
        <span class="badge badge--success">Required</span>
      </div>
      <label class="field">
        <span>Spotlight tour ID</span>
        <input type="number" name="spotlightTourId" min="1" step="1" required />
      </label>
    </section>
  </div>

  <section class="panel save-panel">
    <div>
      <h3>Publish selections</h3>
      <p>Only valid, published tour IDs should be assigned to public homepage sections.</p>
    </div>
    <p class="form-feedback" data-form-feedback aria-live="polite"></p>
    <button class="button button--primary" type="submit">Save homepage</button>
  </section>
</form>

<%- include('../includes/footer', { layoutMode, scriptPath }) %>
