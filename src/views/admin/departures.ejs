<%- include('../includes/header', {
  activePage,
  layoutMode,
  pageTitle,
  stylesheetPath,
}) %>

<section class="page-heading">
  <div>
    <p class="section-label">Availability</p>
    <h2>Tour departures</h2>
    <p>Schedule departure dates and maintain authoritative pricing and capacity.</p>
  </div>
  <button
    class="button button--primary"
    type="button"
    aria-controls="departure-editor"
    aria-expanded="false"
    data-departure-editor-toggle
  >
    New departure
  </button>
</section>

<section class="panel" id="departure-editor" data-departure-editor hidden>
  <div class="panel__header">
    <div>
      <h3>Departure editor</h3>
      <p>Dates are submitted without local timezone conversion.</p>
    </div>
    <button class="button button--small" type="button" data-disclosure-close>Close</button>
  </div>
  <form data-departure-form novalidate>
    <div class="form-grid form-grid--three">
      <label class="field">
        <span>Tour ID</span>
        <input type="number" name="tourId" min="1" step="1" required />
      </label>
      <label class="field">
        <span>Start date</span>
        <input type="date" name="startDate" required />
      </label>
      <label class="field">
        <span>Status</span>
        <select name="status" required>
          <option value="SCHEDULED">Scheduled</option>
          <option value="SOLD_OUT">Sold out</option>
          <option value="CANCELLED">Cancelled</option>
          <option value="COMPLETED">Completed</option>
        </select>
      </label>
      <label class="field">
        <span>Capacity</span>
        <input type="number" name="capacity" min="1" step="1" required />
      </label>
      <label class="field">
        <span>Price (minor units)</span>
        <input type="number" name="priceCents" min="0" step="1" required />
      </label>
      <label class="field">
        <span>Currency</span>
        <input
          type="text"
          name="currency"
          minlength="3"
          maxlength="3"
          pattern="[A-Za-z]{3}"
          value="USD"
          required
        />
      </label>
    </div>
    <p class="form-feedback" data-form-feedback aria-live="polite"></p>
    <div class="form-actions">
      <button class="button" type="reset">Clear</button>
      <button class="button button--primary" type="submit">Save departure</button>
    </div>
  </form>
</section>

<form class="toolbar" data-departure-filters>
  <label class="field">
    <span>Tour ID</span>
    <input type="number" name="tourId" min="1" step="1" />
  </label>
  <label class="field">
    <span>Status</span>
    <select name="status">
      <option value="">All statuses</option>
      <option value="SCHEDULED">Scheduled</option>
      <option value="SOLD_OUT">Sold out</option>
      <option value="CANCELLED">Cancelled</option>
      <option value="COMPLETED">Completed</option>
    </select>
  </label>
  <label class="field">
    <span>From date</span>
    <input type="date" name="from" />
  </label>
  <button class="button" type="submit">Apply</button>
  <button class="button" type="button" data-filter-reset>Reset</button>
</form>

<section class="table-card" aria-label="Departure records">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Departure</th>
          <th scope="col">Tour ID</th>
          <th scope="col">Start date</th>
          <th scope="col">Capacity</th>
          <th scope="col">Reserved</th>
          <th scope="col">Available</th>
          <th scope="col">Price</th>
          <th scope="col">Status</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody data-departure-rows></tbody>
    </table>
  </div>
  <div class="empty-state" data-departure-empty>
    <div class="empty-state__mark" aria-hidden="true">D</div>
    <h3>No departures loaded</h3>
    <p>No departure records match the current filters.</p>
  </div>
  <div class="pagination">
    <span data-page-summary>Page 1 of 1</span>
    <div class="pagination__actions">
      <button class="button button--small" type="button" data-page-prev disabled>Previous</button>
      <button class="button button--small" type="button" data-page-next disabled>Next</button>
    </div>
  </div>
</section>

<%- include('../includes/footer', { layoutMode, scriptPath }) %>
