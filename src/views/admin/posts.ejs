<%- include('../includes/header', {
  activePage,
  layoutMode,
  pageTitle,
  stylesheetPath,
}) %>

<section class="page-heading">
  <div>
    <p class="section-label">Editorial</p>
    <h1>Blog posts</h1>
    <p>Create, publish, archive, and maintain Cavora travel content.</p>
  </div>
  <button
    class="button button--primary"
    type="button"
    aria-controls="post-editor"
    aria-expanded="false"
    data-post-editor-toggle
  >
    New post
  </button>
</section>

<section class="panel" id="post-editor" data-post-editor hidden>
  <div class="panel__header">
    <div>
      <h3>Post editor</h3>
      <p>Write the article as ordered blocks; the public blog renders them in place.</p>
    </div>
    <button class="button button--small" type="button" data-disclosure-close>Close</button>
  </div>
  <form data-post-form novalidate>
    <div class="form-grid">
      <label class="field field--full">
        <span>Title</span>
        <input type="text" name="title" maxlength="240" required />
      </label>
      <label class="field">
        <span>Slug</span>
        <input
          type="text"
          name="slug"
          maxlength="200"
          pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
          required
        />
      </label>
      <label class="field">
        <span>Category</span>
        <input type="text" name="category" maxlength="100" required />
      </label>
      <label class="field">
        <span>Author name</span>
        <input type="text" name="authorName" maxlength="160" required />
      </label>
      <label class="field">
        <span>Status</span>
        <select name="status" required>
          <option value="DRAFT">Draft</option>
          <option value="PUBLISHED">Published</option>
          <option value="ARCHIVED">Archived</option>
        </select>
      </label>
      <%- include('../includes/image-upload', {
        existingInputName: 'imageUrl',
        fieldClass: 'field--full image-upload-field--compact',
        inputDataAttribute: 'data-blog-image-file',
        inputId: 'blog-featured-image',
        inputName: 'image',
        label: 'Featured image',
        maxFiles: 1,
        multiple: false,
      }) %>
      <input type="hidden" name="imageUrl" />
      <label class="field field--full">
        <span>Short summary</span>
        <textarea name="excerpt" maxlength="1000" required></textarea>
        <small>Shown on the blog card before a reader opens the post.</small>
      </label>

      <div class="field field--full content-builder">
        <div class="content-builder__heading">
          <div class="content-builder__intro">
            <span class="field-label">Article content</span>
            <small>Readers see these blocks in the order listed below.</small>
          </div>
          <div class="button-row">
            <button class="button button--small" type="button" data-block-add="paragraph">
              Add paragraph
            </button>
            <button class="button button--small" type="button" data-block-add="heading">
              Add heading
            </button>
            <button class="button button--small" type="button" data-block-add="quote">
              Add quote
            </button>
            <button class="button button--small" type="button" data-block-add="list">
              Add list
            </button>
          </div>
        </div>
        <div class="content-builder__list" data-block-list></div>
      </div>
    </div>
    <p class="form-feedback" data-form-feedback aria-live="polite"></p>
    <div class="form-actions">
      <button class="button button--danger" type="reset">Clear</button>
      <button class="button button--primary" type="submit">Save post</button>
    </div>
  </form>
</section>

<form class="toolbar" data-post-filters>
  <label class="field field--wide">
    <span>Search posts</span>
    <input type="search" name="query" maxlength="200" placeholder="Title, slug, or category" />
  </label>
  <label class="field">
    <span>Status</span>
    <select name="status">
      <option value="">All statuses</option>
      <option value="DRAFT">Draft</option>
      <option value="PUBLISHED">Published</option>
      <option value="ARCHIVED">Archived</option>
    </select>
  </label>
  <button class="button" type="submit">Apply</button>
  <button class="button" type="button" data-filter-reset>Reset</button>
</form>

<section class="table-card" aria-label="Blog post records">
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Title</th>
          <th scope="col">Category</th>
          <th scope="col">Author</th>
          <th scope="col">Published</th>
          <th scope="col">Status</th>
          <th scope="col">Updated</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody data-post-rows></tbody>
    </table>
  </div>
  <div class="empty-state" data-post-empty>
    <div class="empty-state__mark" aria-hidden="true">P</div>
    <h3>No posts loaded</h3>
    <p>No blog posts match the current filters.</p>
  </div>
</section>

<%- include('../includes/footer', { layoutMode, scriptPath }) %>
