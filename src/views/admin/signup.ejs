<%- include('../includes/header', {
  activePage,
  layoutMode,
  pageTitle,
  stylesheetPath,
}) %>

<section class="signup-card" aria-labelledby="signup-heading">
  <div class="signup-card__header">
    <p class="section-label">First-time setup</p>
    <h1 id="signup-heading">Create administrator</h1>
    <p>Only one administrator account can exist. After it is created, use the login page.</p>
  </div>

  <form class="signup-form" data-signup-form novalidate>
    <div class="signup-grid">
      <label class="field">
        <span>First name</span>
        <input type="text" name="firstName" maxlength="80" autocomplete="given-name" required />
      </label>
      <label class="field">
        <span>Last name</span>
        <input type="text" name="lastName" maxlength="80" autocomplete="family-name" required />
      </label>
      <label class="field field--full">
        <span>Username</span>
        <input
          type="text"
          name="username"
          minlength="3"
          maxlength="40"
          pattern="[A-Za-z0-9_]+"
          autocomplete="username"
          required
        />
      </label>
      <label class="field field--full">
        <span>Email address</span>
        <input
          type="email"
          name="email"
          maxlength="254"
          autocomplete="email"
          placeholder="admin@cavora.com"
          required
        />
      </label>
      <label class="field field--full">
        <span>Password</span>
        <span class="password-field">
          <input
            type="password"
            name="password"
            minlength="8"
            maxlength="128"
            autocomplete="new-password"
            required
            data-password-input
          />
          <button type="button" data-password-toggle aria-pressed="false">Show</button>
        </span>
      </label>
      <label class="field field--full">
        <span>Confirm password</span>
        <input
          type="password"
          name="confirmPassword"
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          required
          data-password-input
        />
      </label>
    </div>

    <p class="form-feedback" data-form-feedback aria-live="polite"></p>
    <button class="button button--primary signup-submit" type="submit">
      Create administrator
    </button>
  </form>

  <p class="signup-card__note">Already configured? <a href="/admin/login">Sign in</a></p>
</section>

<%- include('../includes/footer', { layoutMode, scriptPath }) %>
