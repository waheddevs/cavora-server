<%- include('../includes/header', {
  activePage,
  layoutMode,
  pageTitle,
  stylesheetPath,
}) %>

<section class="page-heading">
  <div>
    <p class="section-label">Audience</p>
    <h2>Newsletter subscriptions</h2>
    <p>Review subscribers and maintain their confirmation and subscription status.</p>
  </div>
</section>

<div class="summary-grid">
  <article class="summary-card">
    <span>Active subscribers</span>
    <strong data-newsletter-active>—</strong>
    <small>Currently subscribed</small>
  </article>
  <article class="summary-card">
    <span>Pending confirmation</span>
    <strong data-newsletter-pending>—</strong>
    <small>Awaiting verification</small>
  </article>
  <article class="summary-card">
    <span>Unsubscribed</span>
    <strong data-newsletter-inactive>—</strong>
    <small>Historical records</small>
  </article>
</div>

<div class="split-layout">
  <div>
    <form class="toolbar" data-newsletter-filters>
      <label class="field field--wide">
        <span>Search email</span>
        <input
          type="search"
          name="query"
          maxlength="200"
          placeholder="subscriber@example.com"
        />
      </label>
      <label class="field">
        <span>Status</span>
        <select name="status">
          <option value="">All statuses</option>
          <option value="PENDING">Pending</option>
          <option value="ACTIVE">Active</option>
          <option value="UNSUBSCRIBED">Unsubscribed</option>
        </select>
      </label>
      <button class="button" type="submit">Apply</button>
      <button class="button" type="button" data-filter-reset>Reset</button>
    </form>

    <section class="table-card" aria-label="Newsletter subscription records">
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Email</th>
              <th scope="col">Subscribed</th>
              <th scope="col">Updated</th>
              <th scope="col">Status</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody data-newsletter-rows></tbody>
        </table>
      </div>
      <div class="empty-state" data-newsletter-empty>
        <div class="empty-state__mark" aria-hidden="true">N</div>
        <h3>No subscribers loaded</h3>
        <p>No newsletter subscriptions match the current filters.</p>
      </div>
      <div class="pagination">
        <span data-page-summary>Page 1 of 1</span>
        <div class="pagination__actions">
          <button class="button button--small" type="button" data-page-prev disabled>
            Previous
          </button>
          <button class="button button--small" type="button" data-page-next disabled>Next</button>
        </div>
      </div>
    </section>
  </div>

  <aside class="panel subscription-panel" aria-labelledby="subscription-heading">
    <div class="panel__header">
      <div>
        <h3 id="subscription-heading">Update subscriber</h3>
        <p>Change the current subscription lifecycle state.</p>
      </div>
    </div>
    <form data-newsletter-status-form novalidate>
      <div class="form-grid">
        <label class="field field--full">
          <span>Subscription ID</span>
          <input
            type="text"
            name="id"
            minlength="24"
            maxlength="24"
            pattern="[a-fA-F0-9]{24}"
            required
          />
        </label>
        <label class="field field--full">
          <span>Status</span>
          <select name="status" required>
            <option value="PENDING">Pending</option>
            <option value="ACTIVE">Active</option>
            <option value="UNSUBSCRIBED">Unsubscribed</option>
          </select>
        </label>
      </div>
      <p class="form-feedback" data-form-feedback aria-live="polite"></p>
      <div class="form-actions">
        <button class="button button--primary" type="submit">Update subscriber</button>
      </div>
    </form>
  </aside>
</div>

<%- include('../includes/footer', { layoutMode, scriptPath }) %>
