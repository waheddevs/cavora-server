<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title><%= pageTitle %> | Cavora Admin</title>
    <link rel="stylesheet" href="/admin-assets/vendor/sweetalert2.min.css" />
    <link rel="stylesheet" href="/admin-assets/css/admin-shell.css" />
    <link rel="stylesheet" href="/admin-assets/css/sweetalert-theme.css" />
    <link rel="stylesheet" href="<%= stylesheetPath %>" />
  </head>
  <body class="auth-page">
    <div class="auth-shell" data-csrf-cookie-name="<%= csrfCookieName %>">
      <header class="auth-header">
        <a class="auth-brand" href="/admin/login" aria-label="Cavora admin">
          <img class="auth-brand__logo" src="/admin-assets/img/logo.svg" alt="Cavora" />
          <small>Administration</small>
        </a>
      </header>

      <main class="auth-main">
        <section class="login-card" aria-labelledby="login-heading">
          <div class="login-card__header">
            <p class="section-label">Secure access</p>
            <h1 id="login-heading">Login</h1>
            <p>Enter your administrator credentials to continue.</p>
          </div>

          <form class="login-form" data-login-form novalidate>
            <label class="field">
              <span>Email address</span>
              <input
                type="email"
                name="email"
                autocomplete="username"
                maxlength="254"
                required
              />
            </label>

            <label class="field">
              <span>Password</span>
              <span class="password-field">
                <input
                  type="password"
                  name="password"
                  autocomplete="current-password"
                  maxlength="128"
                  required
                  data-password-input
                />
                <button type="button" data-password-toggle aria-pressed="false">Show</button>
              </span>
            </label>

            <p class="form-feedback" data-form-feedback aria-live="polite"></p>
            <button class="button button--primary login-submit" type="submit">Login</button>
          </form>

          <p class="login-card__note">
            Need the first administrator? <a href="/admin/signup">Signup</a>
          </p>
        </section>
      </main>

      <footer class="auth-footer">
        <span>&copy; <span data-current-year></span> Cavora</span>
        <span>Authorized personnel only</span>
      </footer>
    </div>

    <script src="/admin-assets/vendor/sweetalert2.min.js" defer></script>
    <script src="/admin-assets/js/admin-shell.js" defer></script>
    <script src="<%= scriptPath %>" defer></script>
  </body>
</html>
