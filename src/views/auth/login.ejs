<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title><%= pageTitle %> | Cavora Admin</title>
    <link rel="stylesheet" href="/assets/vendor/sweetalert2.min.css" />
    <link rel="stylesheet" href="/assets/css/admin-shell.css" />
    <link rel="stylesheet" href="/assets/css/sweetalert-theme.css" />
    <link rel="stylesheet" href="<%= stylesheetPath %>" />
  </head>
  <body class="auth-page">
    <div
      class="admin-notice"
      data-admin-notice
      role="status"
      aria-live="polite"
      aria-atomic="true"
      hidden
    >
      <span data-admin-notice-message></span>
      <button type="button" data-admin-notice-close>Dismiss</button>
    </div>

    <div class="auth-shell">
      <header class="auth-header">
        <a class="admin-brand admin-brand--dark" href="/admin/login" aria-label="Cavora admin">
          <span class="admin-brand__mark" aria-hidden="true">C</span>
          <span>
            <strong>Cavora</strong>
            <small>Administration</small>
          </span>
        </a>
      </header>

      <main class="auth-main">
        <section class="login-card" aria-labelledby="login-heading">
          <div class="login-card__header">
            <p class="section-label">Secure access</p>
            <h1 id="login-heading">Admin Login</h1>
            <p>Enter your administrator credentials to continue.</p>
          </div>

          <form class="login-form" data-login-form novalidate>
            <label class="field">
              <span>Email address</span>
              <input
                type="email"
                name="email"
                autocomplete="username"
                maxlength="254"
                required
              />
            </label>

            <label class="field">
              <span>Password</span>
              <span class="password-field">
                <input
                  type="password"
                  name="password"
                  autocomplete="current-password"
                  maxlength="128"
                  required
                  data-password-input
                />
                <button type="button" data-password-toggle aria-pressed="false">Show</button>
              </span>
            </label>

            <p class="form-feedback" data-form-feedback aria-live="polite"></p>
            <button class="button button--primary login-submit" type="submit">Login</button>
          </form>

          <p class="login-card__note">
            Need the first administrator? <a href="/admin/signup">Signup</a>
          </p>
        </section>
      </main>

      <footer class="auth-footer">
        <span>&copy; <span data-current-year></span> Cavora</span>
        <span>Authorized personnel only</span>
      </footer>
    </div>

    <script src="/assets/vendor/sweetalert2.min.js" defer></script>
    <script src="/assets/js/admin-shell.js" defer></script>
    <script src="<%= scriptPath %>" defer></script>
  </body>
</html>
